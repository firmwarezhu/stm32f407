# Keep every text file LF in the repository AND in the working tree.
# Git for Windows ships with core.autocrlf=true at system level; without this
# file a clone on another machine can produce whole-file line-ending diffs.
* text=auto eol=lf

# PowerShell scripts are the one exception: CRLF is the native convention.
*.ps1 text eol=crlf

# Explicitly mark binaries so Git never tries to normalise or diff them.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.7z binary
*.elf binary
*.bin binary
*.o binary
*.obj binary
